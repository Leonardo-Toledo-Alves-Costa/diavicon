diff -ruN --strip-trailing-cr /sessions/rcw-012ymvkusojxtrxfthx3gzeg/base_m/lib/core/widgets/imagem_storage.dart lib/core/widgets/imagem_storage.dart
--- /sessions/rcw-012ymvkusojxtrxfthx3gzeg/base_m/lib/core/widgets/imagem_storage.dart	1970-01-01 00:00:00.000000000 +0000
+++ lib/core/widgets/imagem_storage.dart	2026-09-21 19:44:40.364322500 +0000
@@ -0,0 +1,122 @@
+import 'dart:async';
+import 'dart:ui' as ui;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart';
+import 'package:http/http.dart' as http;
+
+import '../services/storage_urls.dart';
+
+/// Substituto direto de `NetworkImage` que funciona com buckets privados.
+///
+/// Para URLs do Storage, pede um link temporário (ver [StorageUrls]) antes
+/// de baixar. Para qualquer outra URL, baixa normalmente. A chave do cache de
+/// imagens do Flutter é a URL original, então a imagem não é baixada de novo
+/// quando o link assinado muda.
+@immutable
+class StorageNetworkImage extends ImageProvider<StorageNetworkImage> {
+  const StorageNetworkImage(this.url, {this.scale = 1.0, this.headers});
+
+  final String url;
+  final double scale;
+  final Map<String, String>? headers;
+
+  @override
+  Future<StorageNetworkImage> obtainKey(ImageConfiguration configuration) {
+    return SynchronousFuture<StorageNetworkImage>(this);
+  }
+
+  @override
+  ImageStreamCompleter loadImage(StorageNetworkImage key, ImageDecoderCallback decode) {
+    return MultiFrameImageStreamCompleter(
+      codec: _carregar(key, decode),
+      scale: key.scale,
+      debugLabel: key.url,
+      informationCollector: () => <DiagnosticsNode>[
+        DiagnosticsProperty<ImageProvider>('Image provider', this),
+        DiagnosticsProperty<StorageNetworkImage>('Image key', key),
+      ],
+    );
+  }
+
+  Future<ui.Codec> _carregar(StorageNetworkImage key, ImageDecoderCallback decode) async {
+    try {
+      final alvo = await StorageUrls.assinar(key.url);
+      final uri = Uri.parse(alvo);
+      final resposta = await http.get(uri, headers: key.headers);
+      if (resposta.statusCode != 200 || resposta.bodyBytes.isEmpty) {
+        throw NetworkImageLoadException(statusCode: resposta.statusCode, uri: uri);
+      }
+      final buffer = await ui.ImmutableBuffer.fromUint8List(resposta.bodyBytes);
+      return decode(buffer);
+    } catch (_) {
+      // Não deixa a falha presa no cache: a próxima tentativa baixa de novo.
+      scheduleMicrotask(() => PaintingBinding.instance.imageCache.evict(key));
+      rethrow;
+    }
+  }
+
+  @override
+  bool operator ==(Object other) =>
+      other is StorageNetworkImage && other.url == url && other.scale == scale;
+
+  @override
+  int get hashCode => Object.hash(url, scale);
+
+  @override
+  String toString() => '${objectRuntimeType(this, 'StorageNetworkImage')}("$url", scale: ${scale.toStringAsFixed(1)})';
+}
+
+/// Substituto direto de `Image.network` (mesmos parâmetros) que usa
+/// [StorageNetworkImage].
+abstract final class ImagemStorage {
+  static Widget network(
+    String src, {
+    Key? key,
+    double scale = 1.0,
+    ImageFrameBuilder? frameBuilder,
+    ImageLoadingBuilder? loadingBuilder,
+    ImageErrorWidgetBuilder? errorBuilder,
+    String? semanticLabel,
+    bool excludeFromSemantics = false,
+    double? width,
+    double? height,
+    Color? color,
+    Animation<double>? opacity,
+    BlendMode? colorBlendMode,
+    BoxFit? fit,
+    AlignmentGeometry alignment = Alignment.center,
+    ImageRepeat repeat = ImageRepeat.noRepeat,
+    Rect? centerSlice,
+    bool matchTextDirection = false,
+    bool gaplessPlayback = false,
+    FilterQuality filterQuality = FilterQuality.medium,
+    bool isAntiAlias = false,
+    Map<String, String>? headers,
+    int? cacheWidth,
+    int? cacheHeight,
+  }) {
+    return Image(
+      key: key,
+      image: ResizeImage.resizeIfNeeded(cacheWidth, cacheHeight, StorageNetworkImage(src, scale: scale, headers: headers)),
+      frameBuilder: frameBuilder,
+      loadingBuilder: loadingBuilder,
+      errorBuilder: errorBuilder,
+      semanticLabel: semanticLabel,
+      excludeFromSemantics: excludeFromSemantics,
+      width: width,
+      height: height,
+      color: color,
+      opacity: opacity,
+      colorBlendMode: colorBlendMode,
+      fit: fit,
+      alignment: alignment,
+      repeat: repeat,
+      centerSlice: centerSlice,
+      matchTextDirection: matchTextDirection,
+      gaplessPlayback: gaplessPlayback,
+      filterQuality: filterQuality,
+      isAntiAlias: isAntiAlias,
+    );
